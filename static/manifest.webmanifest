{
  "id": "./",
  "name": "Financeiro",
  "short_name": "Financeiro",
  "description": "As contas de casa num lugar só: importa extratos e faturas, separa por categoria e mostra o mês e a previsão.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#060A09",
  "theme_color": "#08120F",
  "categories": [
    "finance",
    "productivity",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Importar extrato ou fatura",
      "short_name": "Importar",
      "url": "./?abrir=importar#/",
      "icons": [
        {
          "src": "shortcuts/import.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Novo lançamento",
      "short_name": "Novo",
      "url": "./?abrir=novo#/transacoes",
      "icons": [
        {
          "src": "shortcuts/new.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notas e listas",
      "short_name": "Notas",
      "url": "./#/notas",
      "icons": [
        {
          "src": "shortcuts/notes.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./receber",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            ".ofx",
            ".csv",
            ".pdf",
            ".txt",
            "text/csv",
            "text/plain",
            "application/pdf",
            "application/x-ofx",
            "application/vnd.ms-excel",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./#/",
      "accept": {
        "application/x-ofx": [
          ".ofx"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/inicio.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Início: saldo, panorama do mês e previsão"
    },
    {
      "src": "screenshots/lancamentos.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Lançamentos: entradas e saídas por categoria"
    },
    {
      "src": "screenshots/computador.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "No computador"
    }
  ]
}
